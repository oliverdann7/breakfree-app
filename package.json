{
  "name": "breakfree-app",
  "version": "1.0.0",
  "description": "BreakFree Türkiye - Premium wellness community app",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "eject": "expo eject",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prepare": "husky install",
    "setup:hooks": "husky install",
    "eas:build:preview": "eas build --platform all --profile preview",
    "eas:build:production": "eas build --platform all",
    "eas:submit": "eas submit --platform all",
    "test:rules": "firebase emulators:exec --only firestore --project breakfree-rules-test \"jest --config rules-tests/jest.config.js\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@reduxjs/toolkit": "^1.9.7",
    "@sentry/react-native": "~7.11.0",
    "axios": "^1.6.8",
    "expo": "^56.0.17",
    "expo-apple-authentication": "~56.0.4",
    "expo-constants": "~56.0.22",
    "expo-linking": "~56.0.16",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.22",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-video": "~56.1.4",
    "firebase": "^12.16.0",
    "i18next": "^23.7.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^14.0.0",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "^2.16.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "react-native-youtube-iframe": "^2.4.1",
    "react-redux": "^8.1.3",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/react": "^14.1.2",
    "@testing-library/react-native": "^12.4.1",
    "@types/react": "~19.2.14",
    "babel-jest": "^29.7.0",
    "eslint": "^8.55.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "husky": "^8.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-mock-axios": "^4.6.1",
    "lint-staged": "^15.2.2",
    "prettier": "^3.1.1",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/functions/",
      "/rules-tests/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-.*|@react-navigation|@react-native-async-storage|@react-native-google-signin|@testing-library|expo|@expo|expo-.*|@sentry|react-native-reanimated|react-native-gesture-handler|react-native-screens|react-native-safe-area-context|react-native-svg)/)"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.js",
      "!src/**/index.js",
      "!src/App.js"
    ]
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
