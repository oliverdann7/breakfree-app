{
  // Production-dependency audit gate for Cloud Functions (Functions CI). Fails
  // on any high/critical advisory. If one ever has no fix, allowlist its GHSA
  // id here with a comment saying why and when it clears (see ../audit-ci.jsonc).
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "skip-dev": true,
  "allowlist": [],
}
