# Non-secret Cloud Functions config. Copy to .env (or .env.<project-id>);
# the Firebase CLI loads it into process.env at deploy time.
# Secrets (AGORA_APP_CERT, REVENUECAT_WEBHOOK_TOKEN) do NOT go here — use
# `firebase functions:secrets:set <NAME>`; see README.md.

# Agora project App ID (live audio talks)
AGORA_APP_ID=

# Daily Firestore export destination, e.g. gs://breakfree-backups
BACKUP_BUCKET=
